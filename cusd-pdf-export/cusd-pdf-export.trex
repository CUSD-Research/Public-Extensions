
<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1"
  xmlns="http://www.tableau.com/xml/extension_manifest">

  <dashboard-extension id="com.cusd80.pdf-export"
    extension-version="1.0.0">

    <default-locale>en_US</default-locale>

    <name resource-id="name"/>
    <description resource-id="description"/>

    <author
      name="CUSD Research &amp; Data Analytics"
      email="research@cusd80.com"
      organization="Chandler Unified School District"
      website="https://www.cusd80.com"/>

    <min-api-version>1.4</min-api-version>

  <source-location>
      <url>https://github.com/CUSD-Research/Public-Extensions/blob/main/cusd-pdf-export/index.html</url>
    </source-location>

    <permissions>
      <permission>full data</permission>
    </permissions>

  </dashboard-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">CUSD PDF Export</text>
    </resource>
    <resource id="description">
      <text locale="en_US">Configurable PDF export for Tableau dashboards.</text>
    </resource>
  </resources>

</manifest>
