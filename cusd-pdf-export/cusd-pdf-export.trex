<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.cusd80.pdf-export" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>CUSD PDF Export configuration extension. PDF rendering is not yet implemented.</description>
    <author name="CUSD Research and Data Analytics" email="research@cusd80.com" organization="Chandler Unified School District" website="https://www.cusd80.com"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://cusd-research.github.io/Public-Extensions/cusd-pdf-export/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name"><text locale="en_US">CUSD PDF Export</text></resource>
  </resources>
</manifest>


