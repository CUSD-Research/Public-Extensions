<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.cusd80.research.feederflow" extension-version="0.2.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>CUSD Research feeder flow. Draws where one school's students went the next year: the students who stayed become a headline, and the flow gives its whole height to the ones who moved, with every destination labelled by count and share of the cohort.</description>
    <author name="CUSD Research and Data Analytics" email="research@cusd80.com" organization="Chandler Unified School District" website="https://www.cusd80.com"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <!-- GitHub Pages URL: org CUSD-Research, repo Public-Extensions, this extension in the
           cusd-feeder-flow/ subfolder. Pages paths are case-sensitive. Allow-list the host
           https://cusd-research.github.io on the Tableau Cloud site. -->
      <url>https://cusd-research.github.io/Public-Extensions/cusd-feeder-flow/index.html</url>
    </source-location>
    <icon></icon>
    <!-- "full data" lets the extension read the worksheet's summary data, which is how it
         gets the rows to draw. It never sends that data anywhere. -->
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">CUSD Feeder Flow</text>
    </resource>
  </resources>
</manifest>
