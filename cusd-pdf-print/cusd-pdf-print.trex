<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.cusd80.research.pdfprint" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>CUSD Research PDF print button. Tableau's own PDF export is rendered server-side and leaves every dashboard extension blank; this button prints the dashboard through the browser instead, where extensions do render, carrying the current filters and scaling the dashboard onto the chosen paper.</description>
    <author name="CUSD Research and Data Analytics" email="research@cusd80.com" organization="Chandler Unified School District" website="https://www.cusd80.com"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <!-- GitHub Pages URL: org CUSD-Research, repo Public-Extensions, this extension in the
           cusd-pdf-print/ subfolder. Pages paths are case-sensitive. Allow-list the host
           https://cusd-research.github.io on the Tableau Cloud site.

           This extension MUST be network-enabled (hosted by us, not sandboxed): its whole
           mechanism is opening a window on its own origin so that window can print itself.
           A sandboxed extension is hosted by Tableau and cannot do that. -->
      <url>https://cusd-research.github.io/Public-Extensions/cusd-pdf-print/index.html</url>
    </source-location>
    <icon></icon>
    <!-- No <permissions> block: this extension reads only dashboard METADATA — the filter
         and parameter selections already visible on screen, the dashboard's name, and the
         positions and sizes of its objects. It never calls getSummaryDataAsync or
         getUnderlyingDataAsync, so viewers get no data-access prompt and no data rows are
         read. The printed copy is fetched by the viewer's own browser under the viewer's own
         Tableau session, so row-level security applies to it exactly as it does on screen.
         If a future Tableau build requires "full data" to read filter VALUES, add
         <permissions><permission>full data</permission></permissions> here and re-add the
         extension to the dashboard. -->
    <!-- Adds the "Configure…" item so the author can set the view URL and paper options. -->
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">CUSD PDF Print</text>
    </resource>
  </resources>
</manifest>
